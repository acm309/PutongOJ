{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [ "^build" ],
      "outputs": [ "dist/**", ".vitepress/dist/**" ]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": [ "^build" ],
      "outputs": [ ".nyc_output/**", "coverage.lcov" ]
    },
    "typecheck": {
      "dependsOn": [ "^build" ],
      "outputs": []
    }
  }
}
