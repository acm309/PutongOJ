{
  "name": "@putong-oj/tasks",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && mkdir -p dist/modules/judger && cp -R src/modules/judger/assets dist/modules/judger/assets",
    "clean": "rm -rf dist coverage",
    "coverage": "c8 report --reporter=text-lcov > coverage.lcov",
    "dev": "concurrently --names judger,worker \"pnpm run dev:judger\" \"pnpm run dev:worker\"",
    "dev:judger": "cross-env NODE_ENV=development node --watch src/modules/judger/main.ts",
    "dev:worker": "cross-env NODE_ENV=development node --watch src/modules/worker/main.ts",
    "start": "pnpm run start:judger",
    "start:judger": "cross-env NODE_ENV=production node dist/modules/judger/main.js",
    "start:worker": "cross-env NODE_ENV=production node dist/modules/worker/main.js",
    "test": "cross-env NODE_ENV=test c8 ava",
    "test:integration": "cross-env NODE_ENV=test PTOJ_RUN_INTEGRATION=1 c8 ava",
    "test:unit": "cross-env NODE_ENV=test c8 ava --match='!*integration*'",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@putong-oj/db": "workspace:*",
    "@putong-oj/shared": "workspace:*",
    "cross-env": "catalog:",
    "fast-levenshtein": "catalog:",
    "fs-extra": "catalog:",
    "ioredis": "catalog:",
    "superagent": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/superagent": "catalog:",
    "ava": "catalog:",
    "c8": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:"
  },
  "ava": {
    "concurrency": 1,
    "environmentVariables": {
      "NODE_ENV": "test"
    },
    "extensions": [
      "ts",
      "js"
    ],
    "files": [
      "test/**/*.test.{js,ts}"
    ],
    "serial": true,
    "timeout": "2m"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
