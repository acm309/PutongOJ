{
  "name": "@putong-oj/server",
  "type": "module",
  "private": true,
  "main": "app.ts",
  "scripts": {
    "build": "tsc && cp -r src/scripts dist/scripts",
    "coverage": "c8 report --reporter=text-lcov > coverage.lcov",
    "deploy:init": "cross-env NODE_ENV=production node setup.js",
    "deploy:start": "pnpm exec pm2 start pm2.config.json",
    "dev": "concurrently \"pnpm run dev:app\" \"pnpm run dev:ws\" \"pnpm run dev:updater\" \"pnpm run dev:worker\"",
    "dev:app": "cross-env NODE_ENV=development node --watch src/app.ts",
    "dev:updater": "cross-env NODE_ENV=development node --watch src/jobs/updater.ts",
    "dev:worker": "cross-env NODE_ENV=development node --watch src/jobs/worker.ts",
    "dev:ws": "cross-env NODE_ENV=development node --watch src/ws.ts",
    "posttest": "cross-env NODE_ENV=test node test/posttest.ts",
    "pretest": "cross-env NODE_ENV=test node test/pretest.ts",
    "report": "c8 report --reporter=html",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "test": "cross-env NODE_ENV=test c8 ava",
    "typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.test.json"
  },
  "dependencies": {
    "@koa/router": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@putong-oj/shared": "workspace:*",
    "@zip.js/zip.js": "catalog:",
    "cross-env": "catalog:",
    "dotenv-flow": "catalog:",
    "fast-levenshtein": "catalog:",
    "fs-extra": "catalog:",
    "ioredis": "catalog:",
    "koa": "catalog:",
    "koa-body": "catalog:",
    "koa-logger": "catalog:",
    "koa-ratelimit": "catalog:",
    "koa-send": "catalog:",
    "koa-session": "catalog:",
    "koa-static": "catalog:",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "mongoose": "catalog:",
    "mongoose-paginate-v2": "catalog:",
    "pm2": "catalog:",
    "superagent": "catalog:",
    "tracer": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/koa": "catalog:",
    "@types/koa-logger": "catalog:",
    "@types/koa-ratelimit": "catalog:",
    "@types/koa-send": "catalog:",
    "@types/koa-static": "catalog:",
    "@types/koa__router": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/superagent": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "ava": "catalog:",
    "c8": "catalog:",
    "concurrently": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  },
  "ava": {
    "concurrency": 1,
    "environmentVariables": {
      "NODE_ENV": "test"
    },
    "extensions": [
      "ts",
      "js"
    ],
    "files": [
      "test/**/*.test.{js,ts}"
    ],
    "require": [
      "./test/_force-exit.mjs"
    ],
    "serial": true,
    "timeout": "30s"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
