{
  "name": "@putong-oj/server",
  "private": true,
  "main": "app.ts",
  "scripts": {
    "build": "tsc && cp -r src/scripts dist/scripts",
    "coverage": "nyc report --reporter=text-lcov > coverage.lcov",
    "deploy:init": "cross-env NODE_ENV=production node setup.js",
    "deploy:start": "pnpm exec pm2 start pm2.config.json",
    "dev": "concurrently \"pnpm run dev:app\" \"pnpm run dev:ws\" \"pnpm run dev:updater\" \"pnpm run dev:worker\"",
    "dev:app": "cross-env NODE_ENV=development nodemon -e ts,js --exec ts-node src/app.ts",
    "dev:updater": "cross-env NODE_ENV=development nodemon -e ts,js --exec ts-node src/jobs/updater.ts",
    "dev:worker": "cross-env NODE_ENV=development nodemon -e ts,js --exec ts-node src/jobs/worker.ts",
    "dev:ws": "cross-env NODE_ENV=development nodemon -e ts,js --exec ts-node src/ws.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "posttest": "cross-env NODE_ENV=test ts-node test/posttest.ts",
    "pretest": "cross-env NODE_ENV=test ts-node test/pretest.ts",
    "report": "nyc report --reporter=html",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "test": "cross-env-shell NODE_ENV=test \"ts-node test/pretest.ts && nyc ava && ts-node test/posttest.ts\"",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@koa/router": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@putong-oj/shared": "workspace:*",
    "@zip.js/zip.js": "catalog:",
    "cross-env": "catalog:",
    "dotenv-flow": "catalog:",
    "fast-levenshtein": "catalog:",
    "fs-extra": "catalog:",
    "ioredis": "catalog:",
    "koa": "catalog:",
    "koa-body": "catalog:",
    "koa-logger": "catalog:",
    "koa-ratelimit": "catalog:",
    "koa-send": "catalog:",
    "koa-session": "catalog:",
    "koa-static": "catalog:",
    "lodash": "catalog:",
    "luxon": "catalog:",
    "mongoose": "catalog:",
    "mongoose-paginate-v2": "catalog:",
    "node-cache": "catalog:",
    "pm2": "catalog:",
    "superagent": "catalog:",
    "tracer": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@ava/typescript": "catalog:",
    "@types/fast-levenshtein": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/koa": "catalog:",
    "@types/koa-logger": "catalog:",
    "@types/koa-ratelimit": "catalog:",
    "@types/koa-send": "catalog:",
    "@types/koa-static": "catalog:",
    "@types/koa__router": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/superagent": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "ava": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "nodemon": "catalog:",
    "nyc": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "dist/*",
      "test/*"
    ]
  },
  "ava": {
    "concurrency": 1,
    "environmentVariables": {
      "NODE_ENV": "test"
    },
    "extensions": [
      "ts",
      "js"
    ],
    "files": [
      "test/**/*.test.{js,ts}"
    ],
    "require": [
      "ts-node/register",
      "./test/_force-exit.mjs"
    ],
    "serial": true,
    "timeout": "30s"
  },
  "nyc": {
    "include": [
      "src/**/*.{js,ts}"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "require": [
      "ts-node/register"
    ]
  }
}
